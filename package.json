{
  "name": "cjkonospace",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write . && pnpm format:py",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint:py": "uvx ruff@0.13.3 check scripts wasm",
    "lint:py:fix": "uvx ruff@0.13.3 check --fix scripts wasm",
    "format:py": "uvx ruff@0.13.3 format scripts wasm",
    "format:py:check": "uvx ruff@0.13.3 format --check scripts wasm",
    "quality:py": "pnpm lint:py && pnpm format:py:check",
    "quality": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm knip && pnpm quality:py"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.py": [
      "uvx ruff@0.13.3 check --fix",
      "uvx ruff@0.13.3 format"
    ]
  },

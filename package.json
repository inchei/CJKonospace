    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.47.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
